{
  "name": "cloud-scart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.33.0",
  "description": "Cloud Scart — budget-friendly headless e-commerce storefront built with Nuxt 3, Supabase and WhatsApp checkout.",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@nuxt/image": "^1.8.1",
    "@nuxtjs/supabase": "^2.0.9",
    "@pinia/nuxt": "^0.10.1",
    "@supabase/supabase-js": "^2.108.2",
    "@vueuse/core": "^11.3.0",
    "@vueuse/nuxt": "^11.3.0",
    "nuxt": "^3.14.1592",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.2",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@types/node": "^22.10.1",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "vue-tsc": "^2.1.10"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-darwin-arm64": "1.3.0",
    "@img/sharp-libvips-darwin-x64": "1.3.0",
    "@img/sharp-libvips-linux-arm64": "1.3.0",
    "@img/sharp-libvips-linux-x64": "1.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@nuxt/cli": "3.32.0",
      "@nuxt/image>ipx": "3.1.1",
      "esbuild": "0.28.1",
      "sharp": "0.35.0",
      "srvx": "0.11.22"
    },
    "allowedDeprecatedVersions": {
      "@koa/router": "12.0.2",
      "glob": "<=10.5.0",
      "inflight": "1.0.6",
      "unplugin-vue-router": "0.19.2"
    }
  }
}
