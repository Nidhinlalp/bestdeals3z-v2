# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Project URL (e.g. https://xyzxyzxyz.supabase.co)
SUPABASE_URL=

# Anon / public key — safe to expose to the browser (RLS protects data)
SUPABASE_KEY=

# Service role key — SERVER ONLY. Never expose this to the browser.
# Used by server-only order validation, admin checks and sitemap generation.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ─────────────────────────────────────────────────────────────────────
# Production domain, no trailing slash
NUXT_PUBLIC_SITE_URL=https://cloudscart.in

# WhatsApp number in international format WITHOUT + or spaces (e.g. 919000000000)
NUXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Mandatory legal disclosures ─────────────────────────────────────────────
# Required for a production deployment under Indian e-commerce rules.

# Registered proprietor/company/LLP name operating Cloud Scart
NUXT_PUBLIC_SELLER_LEGAL_NAME=Rijil, trading as Cloud Scart

# Full principal place of business, including street, city, state and pincode
NUXT_PUBLIC_BUSINESS_ADDRESS=Kuttiyil Parambu, Pullumkunnu, Vaidyarangadi P.O., Ramanattukara, Kozhikode, Kerala – 673633

# Full name of the designated consumer grievance officer
NUXT_PUBLIC_GRIEVANCE_OFFICER_NAME=Rijil (Owner & Grievance Officer)

# Optional overrides; defaults to the public store email and phone in site.ts
NUXT_PUBLIC_GRIEVANCE_EMAIL=
NUXT_PUBLIC_GRIEVANCE_PHONE=

# Set to true only after checking that every live image, logo, product detail
# and testimonial is owned, licensed, or used with documented permission.
CONTENT_RIGHTS_CONFIRMED=true
